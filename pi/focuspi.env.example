# FocusPi configuration. deploy.sh copies this to focuspi.env on first run.
# Edit focuspi.env, then:  bash deploy.sh restart

# ---- API ----
FOCUS_PORT=5050
# Shared secret for the phone app (X-API-Key header). Leave empty to disable.
FOCUS_API_KEY=

# ---- Weather (Open-Meteo, free). Either a city name or exact coordinates ----
FOCUS_CITY=New Delhi
FOCUS_LAT=
FOCUS_LON=

# ---- Focus / streak ----
FOCUS_DEFAULT_MINUTES=30
# Completed focus minutes needed in a day for it to count toward the streak
FOCUS_STREAK_MIN_MINUTES=1
# A session you stop early still counts if you focused at least this many minutes
FOCUS_PARTIAL_CREDIT_MINUTES=10

# ---- OLED ----
# sh1106 for most 1.3" modules, ssd1306 for most 0.96" modules
FOCUS_OLED_DRIVER=sh1106
FOCUS_I2C_ADDR=0x3C
FOCUS_OLED_ROTATE=0
FOCUS_24H=1
# Screen dims between these hours (set both equal to disable)
FOCUS_NIGHT_START_HOUR=23
FOCUS_NIGHT_END_HOUR=6
